# ---------------------------------------------------------------------------
# PETER — configuration
# Copy to `.env`. Real environment variables always win over this file.
# ---------------------------------------------------------------------------

# --- web server ---
HOST=127.0.0.1
PORT=8080

# --- ollama ---
# Where Ollama listens. Never exposed to the browser.
OLLAMA_URL=http://127.0.0.1:11434

# Leave empty to use whichever suitable model is installed.
# Set it to pin one, e.g. llama3.2
OLLAMA_MODEL=

# Order of preference when OLLAMA_MODEL is empty.
OLLAMA_MODEL_PREFERENCE=llama3.2,llama3.1,llama3,qwen2.5,mistral,gemma2,phi3,llama2

# --- timeouts (ms) ---
OLLAMA_STATUS_TIMEOUT=2500
OLLAMA_VALIDATE_TIMEOUT=12000
OLLAMA_PRESENT_TIMEOUT=9000
OLLAMA_STATUS_CACHE=8000

# --- features (both degrade to the built-in engine when off or offline) ---
PETER_VALIDATION=true
PETER_PRESENTATION=true

# --- correction thresholds ---
# At or above this, a correction is applied silently.
PETER_AUTO_APPLY_CONFIDENCE=0.95
# Below this, PETER asks the operator to edit rather than guessing.
PETER_CONFIRM_CONFIDENCE=0.70

# --- safety ---
PETER_MAX_BODY=16384
PETER_RATE_LIMIT=60
# Keep false: when true, operator text is written to the server log.
PETER_LOG_TEXT=false
